# Configuration locale du serveur
NODE_ENV=development
PORT=5000

# PostgreSQL local : remplacez CHANGE_ME par le mot de passe de votre compte.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/begectp

